#!/usr/bin/env python3
"""Count Rust source and Dockerfile code lines after plain rustfmt."""
from pathlib import Path
import sys


def rust_code_lines(path: Path) -> int:
    count = 0
    block_depth = 0
    for line in path.read_text(encoding="utf-8").splitlines():
        i = 0
        code = False
        quote = None
        escaped = False
        while i < len(line):
            if block_depth:
                if line.startswith("/*", i):
                    block_depth += 1
                    i += 2
                elif line.startswith("*/", i):
                    block_depth -= 1
                    i += 2
                else:
                    i += 1
                continue
            ch = line[i]
            if quote:
                code = True
                if escaped:
                    escaped = False
                elif ch == "\\":
                    escaped = True
                elif ch == quote:
                    quote = None
                i += 1
            elif line.startswith("//", i):
                break
            elif line.startswith("/*", i):
                block_depth = 1
                i += 2
            elif ch in ('"', "'"):
                quote = ch
                code = True
                i += 1
            else:
                code |= not ch.isspace()
                i += 1
        count += int(code)
    return count


def docker_code_lines(path: Path) -> int:
    return sum(
        bool(line.strip()) and not line.lstrip().startswith("#")
        for line in path.read_text(encoding="utf-8").splitlines()
    )


root = Path(sys.argv[1]) if len(sys.argv) > 1 else Path("track-a")
rust = rust_code_lines(root / "src" / "main.rs")
docker = docker_code_lines(root / "Dockerfile")
print(f"Rust={rust} Dockerfile={docker} S={rust + docker}")
